 /// *************Preconfiguration
 
-#define MAX_INI_COUNT (10)
+// Orchard IMU never has a clean stationary window near the start of a bag
+// (persistent low-level vibration/motion) - a 1s average is heavily biased
+// by whatever transient acceleration happens to be present in that window,
+// producing a fixed few-degree roll/pitch error baked into init_state.grav
+// for the whole run. Widened to ~30s (6000 samples @ ~200Hz) so the
+// average has time to converge toward the true gravity direction instead.
+#define MAX_INI_COUNT (6000)
 
 const bool time_list(PointType &x, PointType &y) {return (x.curvature < y.curvature);};
 
@@ -191,8 +197,19 @@ void ImuProcess::IMU_init(const MeasureGroup &meas, esekfom::esekf<state_ikfom,
   }
   state_ikfom init_state = kf_state.get_x();
   init_state.grav = S2(- mean_acc / mean_acc.norm() * G_m_s2);
-  
-  //state_inout.rot = Eye3d; // Exp(mean_acc.cross(V3D(0, 0, -1 / scale_gravity)));
+
+  // Level the world frame to gravity: without this, world "up" defaults to
+  // whatever the body's raw orientation happened to be at init (identity
+  // rot), so on a vibrating platform the output frame ends up tilted from
+  // true vertical by however much the robot was pitched/rolled at whatever
+  // random instant playback began - not a per-run fluke, a structural bug.
+  // A stationary accelerometer reads +g pointing "up" in body frame, so
+  // aligning mean_acc with world (0,0,1) levels roll/pitch (yaw stays free).
+  {
+    V3D acc_dir = mean_acc.normalized();
+    Eigen::Quaterniond q_level = Eigen::Quaterniond::FromTwoVectors(acc_dir, V3D(0, 0, 1));
+    init_state.rot = SO3(q_level);
+  }
   init_state.bg  = mean_gyr;
   init_state.offset_T_L_I = Lidar_T_wrt_IMU;
   init_state.offset_R_L_I = Lidar_R_wrt_IMU;
